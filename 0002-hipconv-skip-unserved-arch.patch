Skip hipconv arch libraries whose TARGETS miss CMAKE_HIP_ARCHITECTURES.
The parent only records a target hipconv_add_arch_lib actually created,
and the stand-in offload pass only sees those targets. Building CDNA4
or CDNA5 for gfx803 fails typecheck on LLVM 23.

--- a/src/hipconv/cmake/GpuArch.cmake
+++ b/src/hipconv/cmake/GpuArch.cmake
@@ -33,10 +33,18 @@
         message(FATAL_ERROR "hipconv_add_arch_lib(${name}): TARGETS is required")
     endif()
 
-    # NPI is dropped when the build serves none of its GPUs, because its registry
-    # entry must not exist. Every other architecture is built regardless.
+    # Drop an arch the build serves no GPU for.
+    #
+    # Upstream still compiles it, using the first CMAKE_HIP_ARCHITECTURES entry
+    # so the host objects and the registry row exist, and those device bundles
+    # go unused. That stand-in is gfx803 here. CDNA4 (gfx950) and CDNA5 (gfx1250)
+    # MFMA builtins need gfx90a-insts or gfx950-insts and do not typecheck for it
+    # on LLVM 23; a gfx942 stand-in still rejects the gfx950-only 16x16x32 bf16
+    # builtin. No registry row and no device code: the runtime probe reports no
+    # hipconv kernels for a GPU this build does not serve. NPI already did this.
     hipconv_intersect_gpus("${ARG_TARGETS}" served_gpus)
-    if(NOT served_gpus AND ARG_NPI)
+    if(NOT served_gpus)
+        message(STATUS "hipconv: ${name} serves none of CMAKE_HIP_ARCHITECTURES; skipping")
         return()
     endif()
 
